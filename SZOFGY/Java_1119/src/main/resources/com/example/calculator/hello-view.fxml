<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.calculator.CalculatorController"
      prefWidth="260.0">
   <padding>
      <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
   </padding>

   <TextField fx:id="display" editable="false" alignment="CENTER_RIGHT"
              prefHeight="50.0" style="-fx-font-size: 22px;"/>

   <HBox spacing="8.0">
      <Button text="7" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="8" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="9" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="/" onAction="#onOp" prefWidth="60.0" prefHeight="45.0"/>
   </HBox>
   <HBox spacing="8.0">
      <Button text="4" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="5" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="6" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="*" onAction="#onOp" prefWidth="60.0" prefHeight="45.0"/>
   </HBox>
   <HBox spacing="8.0">
      <Button text="1" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="2" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="3" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="-" onAction="#onOp" prefWidth="60.0" prefHeight="45.0"/>
   </HBox>
   <HBox spacing="8.0">
      <Button text="0" onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="." onAction="#onDigit" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="=" onAction="#onEquals" prefWidth="60.0" prefHeight="45.0"/>
      <Button text="+" onAction="#onOp" prefWidth="60.0" prefHeight="45.0"/>
   </HBox>
   <HBox>
      <Button text="C" onAction="#onClear" prefWidth="252.0" prefHeight="45.0"/>
   </HBox>
</VBox>
{
  "maps": {
    "A": "3 15\n....@..........\n.#############.\n.......@...>...\n",
    "B": "1 6\n>.@.@#\n"
  },
  "runCases": [
    { "name": "feladatleírás 1. példa", "map": "A", "code": "set arany to isThere 2\nprint arany",
      "expect": { "status": "OK", "steps": 2, "gold": 0, "output": ["false"] } },
    { "name": "feladatleírás 2. példa (A térkép)", "map": "A",
      "code": "set count to 0\nset fal to isThere 1\nset megy to not fal\nwhile megy\n  set arany to isThere 2\n  if arany\n    step forward 1\n    mine here\n    set count to count + 1\n  else\n    step forward 1\n  set fal to isThere 1\n  set megy to not fal\nprint count",
      "expect": { "status": "OK", "steps": 26, "gold": 0, "output": ["0"], "robot": [2, 14, ">"] } },
    { "name": "feladatleírás 2. példa (B térkép, két arany)", "map": "B",
      "code": "set count to 0\nset fal to isThere 1\nset megy to not fal\nwhile megy\n  set arany to isThere 2\n  if arany\n    step forward 1\n    mine here\n    set count to count + 1\n  else\n    step forward 1\n  set fal to isThere 1\n  set megy to not fal\nprint count",
      "expect": { "status": "OK", "steps": 35, "gold": 2, "output": ["2"], "robot": [0, 4, ">"] } },
    { "name": "üres program", "map": "B", "code": "", "expect": { "status": "OK", "steps": 0, "gold": 0, "output": [] } },
    { "name": "fájl végi sortörés", "map": "B", "code": "print 1\n", "expect": { "status": "OK", "steps": 1, "output": ["1"] } },
    { "name": "nem inicializált változó", "map": "B", "code": "print x", "expect": { "status": "ERROR", "errorCode": "E_UNINITIALIZED", "errorLine": 1, "steps": 1 } },
    { "name": "típusváltás", "map": "B", "code": "set a to 1\nset a to true", "expect": { "status": "ERROR", "errorCode": "E_TYPE_MISMATCH", "errorLine": 2, "steps": 2 } },
    { "name": "nem logikai feltétel (if)", "map": "B", "code": "set a to 5\nif a\n  print a", "expect": { "status": "ERROR", "errorCode": "E_NON_BOOL_CONDITION", "errorLine": 2, "steps": 2 } },
    { "name": "nem logikai feltétel (while)", "map": "B", "code": "while 3", "expect": { "status": "ERROR", "errorCode": "E_NON_BOOL_CONDITION", "errorLine": 1, "steps": 1 } },
    { "name": "rossz operandus +", "map": "B", "code": "set a to true + 1", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND", "errorLine": 1 } },
    { "name": "első operandus hibája előbb", "map": "B", "code": "set a to true + c", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND" } },
    { "name": "második operandus nem inicializált", "map": "B", "code": "set a to 1 + c", "expect": { "status": "ERROR", "errorCode": "E_UNINITIALIZED" } },
    { "name": "or második operandusát is beolvassa", "map": "B", "code": "set a to true or c", "expect": { "status": "ERROR", "errorCode": "E_UNINITIALIZED" } },
    { "name": "egyenlőség eltérő típussal", "map": "B", "code": "set a to 1 = true", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND" } },
    { "name": "egyenlőség: első operandus nem inicializált", "map": "B", "code": "set a to c = 1", "expect": { "status": "ERROR", "errorCode": "E_UNINITIALIZED" } },
    { "name": "logikai egyenlőség működik", "map": "B", "code": "set a to true = false\nprint a\nset b to 3 <> 4\nprint b", "expect": { "status": "OK", "output": ["false", "true"] } },
    { "name": "not egészre", "map": "B", "code": "set a to not 1", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND" } },
    { "name": "and egészre", "map": "B", "code": "set a to true and 1", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND" } },
    { "name": "összehasonlítás logikaira", "map": "B", "code": "set a to true < 1", "expect": { "status": "ERROR", "errorCode": "E_BAD_OPERAND" } },
    { "name": "falnak megy, előtte megáll", "map": "B", "code": "step forward 5", "expect": { "status": "ERROR", "errorCode": "E_BEDROCK_HIT", "errorLine": 1, "steps": 1, "robot": [0, 4, ">"] } },
    { "name": "lelép a térképről", "map": "B", "code": "turn by 1\nstep forward 1", "expect": { "status": "ERROR", "errorCode": "E_BEDROCK_HIT", "errorLine": 2, "robot": [0, 0, "^"] } },
    { "name": "aranyon áthalad, nem szedi fel", "map": "B", "code": "step forward 4\nmine here\nturn by 2\nstep forward 2\nmine here", "expect": { "status": "OK", "gold": 2, "steps": 5, "robot": [0, 2, "<"] } },
    { "name": "bányászás arany nélkül", "map": "B", "code": "mine here", "expect": { "status": "ERROR", "errorCode": "E_NO_GOLD", "errorLine": 1 } },
    { "name": "kétszer ugyanott bányászik", "map": "B", "code": "step forward 2\nmine here\nmine here", "expect": { "status": "ERROR", "errorCode": "E_NO_GOLD", "errorLine": 3, "gold": 1, "steps": 3 } },
    { "name": "turn by true", "map": "B", "code": "turn by true", "expect": { "status": "ERROR", "errorCode": "E_BAD_ARG", "errorLine": 1 } },
    { "name": "isThere 3", "map": "B", "code": "set w to 3\nset b to isThere w", "expect": { "status": "ERROR", "errorCode": "E_BAD_ARG", "errorLine": 2 } },
    { "name": "step forward negatív", "map": "B", "code": "set n to 0 - 1\nstep forward n", "expect": { "status": "ERROR", "errorCode": "E_BAD_ARG", "errorLine": 2 } },
    { "name": "step forward false", "map": "B", "code": "step forward false", "expect": { "status": "ERROR", "errorCode": "E_BAD_ARG" } },
    { "name": "step forward 0", "map": "B", "code": "step forward 0\nprint 0", "expect": { "status": "OK", "steps": 2, "robot": [0, 0, ">"] } },
    { "name": "térkép széle falnak számít", "map": "B", "code": "turn by 2\nset w to isThere 1\nset e to isThere 0\nprint w\nprint e", "expect": { "status": "OK", "output": ["true", "false"] } },
    { "name": "turn by 5 = 1 negyedfordulat balra", "map": "B", "code": "turn by 5", "expect": { "status": "OK", "robot": [0, 0, "^"] } },
    { "name": "turn by 3 = jobbra", "map": "B", "code": "turn by 3", "expect": { "status": "OK", "robot": [0, 0, "v"] } },
    { "name": "üres while törzs -> limit", "map": "B", "code": "while true", "expect": { "status": "ERROR", "errorCode": "INSTRUCTION_COUNT_LIMIT_EXCEEDED", "errorLine": 1, "steps": 1000 } },
    { "name": "végtelen ciklus -> limit", "map": "B", "code": "set i to 0\nwhile true\n  set i to i + 1", "expect": { "status": "ERROR", "errorCode": "INSTRUCTION_COUNT_LIMIT_EXCEEDED", "errorLine": 3, "steps": 1000 } },
    { "name": "pontosan 1000 sor még lefut", "map": "B", "code": "set i to 0\nset lim to 83 * 4\nset go to true\nwhile go\n  set i to i + 1\n  set go to i < lim", "expect": { "status": "OK", "steps": 1000 } },
    { "name": "1001. sor már limit", "map": "B", "code": "set i to 0\nset lim to 83 * 4\nset go to true\nwhile go\n  set i to i + 1\n  set go to i < lim\nprint i", "expect": { "status": "ERROR", "errorCode": "INSTRUCTION_COUNT_LIMIT_EXCEEDED", "errorLine": 7, "steps": 1000 } },
    { "name": "else sor csak hamis feltételnél számít", "map": "B", "code": "if false\n  print 1\nelse\n  print 2", "expect": { "status": "OK", "steps": 3, "output": ["2"] } },
    { "name": "igaz if: else nem számít", "map": "B", "code": "if true\n  print 1\nelse\n  print 2", "expect": { "status": "OK", "steps": 2, "output": ["1"] } },
    { "name": "üres if törzs és else", "map": "B", "code": "if false\nelse\n  print 2", "expect": { "status": "OK", "steps": 3, "output": ["2"] } },
    { "name": "aritmetika és logika", "map": "B", "code": "set a to 7 * 8\nset b to a - 100\nprint b\nset c to b < 0\nprint c\nset d to c and true\nset e to d <> false\nprint e",
      "expect": { "status": "OK", "steps": 8, "output": ["-44", "true", "true"] } },
    { "name": "összehasonlítók", "map": "B", "code": "set a to 3 <= 3\nset b to 3 >= 4\nset c to 4 > 3\nset d to false or false\nprint a\nprint b\nprint c\nprint d",
      "expect": { "status": "OK", "output": ["true", "false", "true", "false"] } },
    { "name": "kis- és nagybetű különböző változó", "map": "B", "code": "set Arany to 1\nset arany to true\nprint Arany\nprint arany", "expect": { "status": "OK", "output": ["1", "true"] } },
    { "name": "blokkonként eltérő behúzás", "map": "B", "code": "if true\n  if true\n      print 1\n  print 2\nprint 3", "expect": { "status": "OK", "steps": 5, "output": ["1", "2", "3"] } },
    { "name": "32 bites túlcsordulás", "map": "B", "code": "set x to 100\nset y to x * x\nset z to y * y\nset q to z * z\nprint z\nprint q", "expect": { "status": "OK", "output": ["100000000", "1874919424"] } },
    { "name": "Windows sorvégek", "map": "B", "code": "set a to 1\r\nprint a\r\n", "expect": { "status": "OK", "output": ["1"] } }
  ],
  "syntaxCases": [
    { "name": "nagybetűs kulcsszó", "code": "Set a to 1", "lines": [1] },
    { "name": "100-nál nagyobb szám", "code": "set a to 101", "lines": [1] },
    { "name": "kulcsszó változónévként (más írásmóddal)", "code": "set True to 1", "lines": [1] },
    { "name": "kulcsszó értékként", "code": "print While", "lines": [1] },
    { "name": "dupla szóköz", "code": "set a  to 1", "lines": [1] },
    { "name": "sorvégi szóköz", "code": "set a to 1 ", "lines": [1] },
    { "name": "üres sor", "code": "print 1\n\nprint 2", "lines": [2] },
    { "name": "csak szóközből álló sor", "code": "print 1\n  \nprint 2", "lines": [2] },
    { "name": "tab a behúzásban", "code": "while true\n\tprint 1", "lines": [2] },
    { "name": "blokkon belül nem egységes behúzás", "code": "if true\n  print 1\n   print 2", "lines": [3] },
    { "name": "nem illeszkedő visszahúzás", "code": "if true\n    print 1\n  print 2", "lines": [3] },
    { "name": "behúzott első sor", "code": "  print 1", "lines": [1] },
    { "name": "behúzás if nélkül", "code": "print 1\n  print 2", "lines": [2] },
    { "name": "else if nélkül", "code": "else\n  print 1", "lines": [1] },
    { "name": "else rossz behúzással", "code": "if true\n  print 1\n  else\n  print 2", "lines": [3] },
    { "name": "step forward hiányzik", "code": "step 1", "lines": [1] },
    { "name": "isThere paraméter nélkül", "code": "set a to isThere", "lines": [1] },
    { "name": "két művelet", "code": "set a to 1 + 2 + 3", "lines": [1] },
    { "name": "not paraméter nélkül", "code": "set a to not", "lines": [1] },
    { "name": "ismeretlen operátor", "code": "set a to 1 / 2", "lines": [1] },
    { "name": "isThere nem set-ben", "code": "print isThere 2", "lines": [1] },
    { "name": "kifejezés if-ben", "code": "if a < 3\n  print a", "lines": [1] },
    { "name": "több hibás sor", "code": "print 1\nfoo bar\nmine here now", "lines": [2, 3] },
    { "name": "isthere kisbetűvel", "code": "set a to isthere 2", "lines": [1] },
    { "name": "számmal kezdődő név", "code": "set 1a to 2", "lines": [1] },
    { "name": "ékezetes név", "code": "set érték to 2", "lines": [1] }
  ],
  "mapCases": [
    { "name": "példa térkép", "text": "3 15\n....@..........\n.#############.\n.......@...>...", "ok": true },
    { "name": "CRLF és záró sortörés", "text": "1 2\r\n>@\r\n", "ok": true },
    { "name": "0 dimenzió", "text": "0 5\n", "ok": false },
    { "name": "16 dimenzió", "text": "1 16\n>...............", "ok": false },
    { "name": "két robot", "text": "1 3\n>.<", "ok": false },
    { "name": "nincs robot", "text": "1 3\n..@", "ok": false },
    { "name": "rossz sorhossz", "text": "2 3\n>..\n..", "ok": false },
    { "name": "kevés sor", "text": "3 3\n>..\n...", "ok": false },
    { "name": "ismeretlen karakter", "text": "1 3\n>.x", "ok": false },
    { "name": "rossz fejléc", "text": "3x3\n>..", "ok": false },
    { "name": "üres fájl", "text": "", "ok": false }
  ]
}
